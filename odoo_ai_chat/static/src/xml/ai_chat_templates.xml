<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Systray Item Template -->
    <t t-name="odoo_ai_chat.SystrayItem" owl="1">
        <div class="o_ai_chat_systray" t-on-click="openChat" title="AI Chat Assistant">
            <img src="/odoo_ai_chat/static/src/img/logo.png" alt="AI Chat" class="o_ai_chat_icon"/>
        </div>
    </t>

    <!-- Main Chat Widget Template -->
    <t t-name="odoo_ai_chat.ChatWidget" owl="1">
        <div class="o_ai_chat_widget">
            <!-- Header -->
            <div class="o_ai_chat_header">
                <button class="btn btn-sm btn-secondary" t-on-click="toggleSessions">
                    <i class="fa fa-bars"/>
                </button>
                <h4 class="o_ai_chat_title">
                    <i class="fa fa-robot me-2"/>
                    AI Chat Assistant
                </h4>
                <button class="btn btn-sm btn-primary" t-on-click="newChat">
                    <i class="fa fa-plus"/> New Chat
                </button>
            </div>

            <div class="o_ai_chat_body">
                <!-- Sessions Sidebar -->
                <div class="o_ai_chat_sessions" t-att-class="state.showSessions ? 'show' : ''">
                    <div class="o_ai_chat_sessions_header">
                        <h5>Recent Chats</h5>
                    </div>
                    <div class="o_ai_chat_sessions_list">
                        <t t-if="state.sessions.length === 0">
                            <div class="o_ai_chat_empty">
                                <p>No chat sessions yet</p>
                            </div>
                        </t>
                        <t t-foreach="state.sessions" t-as="session" t-key="session.id">
                            <div class="o_ai_chat_session_item"
                                 t-att-class="state.currentSessionId === session.id ? 'active' : ''"
                                 t-on-click="() => this.loadSession(session.id)">
                                <div class="o_ai_chat_session_content">
                                    <div class="o_ai_chat_session_name">
                                        <t t-esc="session.name"/>
                                    </div>
                                    <div class="o_ai_chat_session_meta">
                                        <span t-esc="formatDate(session.last_message_date || session.create_date)"/>
                                        <span class="ms-2">
                                            <i class="fa fa-comment"/> <t t-esc="session.message_count"/>
                                        </span>
                                    </div>
                                </div>
                                <button class="btn btn-sm btn-link o_ai_chat_session_delete"
                                        t-on-click="(e) => this.deleteSession(session.id, e)">
                                    <i class="fa fa-trash"/>
                                </button>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Messages Area -->
                <div class="o_ai_chat_messages_container">
                    <div class="o_ai_chat_messages">
                        <t t-if="state.messages.length === 0">
                            <div class="o_ai_chat_welcome">
                                <i class="fa fa-robot fa-3x mb-3"/>
                                <h5>Welcome to AI Chat Assistant</h5>
                                <p>Ask me anything! I can help you with your work in Odoo.</p>
                            </div>
                        </t>

                        <t t-foreach="state.messages" t-as="message" t-key="message_index">
                            <t t-if="message.role !== 'tool'">
                                <div class="o_ai_chat_message"
                                     t-att-class="'o_ai_chat_message_' + message.role">
                                    <div class="o_ai_chat_message_avatar">
                                        <i t-att-class="message.role === 'user' ? 'fa fa-user' : 'fa fa-robot'"/>
                                    </div>
                                    <div class="o_ai_chat_message_content">
                                        <div class="o_ai_chat_message_text">
                                            <t t-esc="message.content"/>
                                        </div>

                                        <!-- Graph canvas -->
                                        <t t-if="message.graph_data">
                                            <div class="o_ai_chat_graph_container">
                                                <canvas t-att-id="'chart_' + (message.id || message_index)"
                                                        class="o_ai_chat_graph_canvas"/>
                                            </div>
                                        </t>

                                        <div class="o_ai_chat_message_time">
                                            <t t-esc="formatDate(message.create_date)"/>
                                        </div>
                                        <t t-if="message.tool_calls">
                                            <div class="o_ai_chat_tool_calls">
                                                <small class="text-muted">
                                                    <i class="fa fa-wrench"/>
                                                    <t t-esc="getMessageTypeIndicator(message) || 'Used tools'"/>
                                                </small>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </t>

                        <t t-if="state.loading">
                            <div class="o_ai_chat_message o_ai_chat_message_assistant">
                                <div class="o_ai_chat_message_avatar">
                                    <i class="fa fa-robot"/>
                                </div>
                                <div class="o_ai_chat_message_content">
                                    <div class="o_ai_chat_typing">
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <div t-ref="messagesEnd"/>
                    </div>

                    <!-- Input Area -->
                    <div class="o_ai_chat_input_container">
                        <div class="o_ai_chat_input">
                            <button class="btn btn-sm btn-secondary o_ai_chat_attach_btn"
                                    t-on-click="onAttachFile"
                                    t-att-disabled="state.loading || state.uploadingFile"
                                    title="Upload PDF Invoice">
                                <i t-att-class="state.uploadingFile ? 'fa fa-spinner fa-spin' : 'fa fa-paperclip'"/>
                            </button>
                            <textarea
                                class="form-control"
                                placeholder="Type your message or upload a PDF invoice..."
                                rows="2"
                                t-model="state.inputMessage"
                                t-on-keypress="onInputKeyPress"
                                t-att-disabled="state.loading || state.uploadingFile"
                            />
                            <button class="btn btn-primary"
                                    t-on-click="sendMessage"
                                    t-att-disabled="state.loading || state.uploadingFile || !state.inputMessage.trim()">
                                <i t-att-class="state.loading ? 'fa fa-spinner fa-spin' : 'fa fa-paper-plane'"/>
                            </button>
                        </div>
                        <!-- Hidden file input -->
                        <input type="file"
                               t-ref="fileInput"
                               style="display: none;"
                               accept=".pdf,application/pdf"
                               t-on-change="onFileSelected"/>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
