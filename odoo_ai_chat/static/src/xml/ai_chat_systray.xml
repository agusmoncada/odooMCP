<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="odoo_ai_chat.AIChatSystray">
        <div class="o_mail_systray_item ai-chat-systray" t-att-class="{ 'show': state.showDropdown }">
            <button class="btn position-relative" t-on-click="toggleDropdown" title="AI Chat">
                <i class="fa fa-robot text-primary" style="font-size: 18px;"/>
                <span class="sr-only">AI Chat</span>
            </button>

            <div t-if="state.showDropdown" class="dropdown-menu dropdown-menu-right show" ref="dropdown">
                <div class="dropdown-header d-flex justify-content-between align-items-center">
                    <strong>AI Assistant</strong>
                    <button class="btn btn-sm btn-outline-primary" t-on-click="createNewChat" title="New Chat">
                        <i class="fa fa-plus"/>
                    </button>
                </div>
                
                <div class="dropdown-item" t-on-click="openMainChat" style="cursor: pointer;">
                    <i class="fa fa-comments text-primary"/> Main AI Chat
                </div>
                
                <div class="dropdown-divider" t-if="state.channels.length > 0"/>
                
                <div t-if="state.loading" class="dropdown-item text-center">
                    <i class="fa fa-spinner fa-spin"/> Loading...
                </div>
                
                <div t-else="">
                    <div t-foreach="state.channels" t-as="channel" t-key="channel.id">
                        <div class="dropdown-item" 
                             t-on-click="() => this.openChannel(channel.id)"
                             style="cursor: pointer;">
                            <div class="d-flex justify-content-between align-items-center">
                                <div style="min-width: 0; flex: 1;">
                                    <div class="text-truncate" t-out="channel.name"/>
                                    <small class="text-muted" t-if="channel.message_count">
                                        <t t-out="channel.message_count"/> msg
                                    </small>
                                </div>
                                <i class="fa fa-chevron-right ml-2"/>
                            </div>
                        </div>
                    </div>
                    
                    <div t-if="state.channels.length >= 5" class="dropdown-item text-center">
                        <small class="text-muted">... and more</small>
                    </div>
                </div>
                
                <div class="dropdown-divider"/>
                <div class="dropdown-item" t-on-click="createNewChat" style="cursor: pointer;">
                    <i class="fa fa-plus text-success"/> Create New Chat
                </div>
            </div>
        </div>
    </t>
</templates>