<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Configuration Settings -->
    <record id="res_config_settings_view_form_inherit_ai_chat" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.chat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="AI Chat" string="AI Chat" data-key="odoo_ai_chat">
                    <h2>AI Chat Assistant</h2>

                    <div class="row mt16 o_settings_container">
                        <!-- OpenRouter Configuration -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="openrouter_api_key" class="col-3 col-lg-3 o_light_label"/>
                                        <field name="openrouter_api_key" password="True"
                                               placeholder="sk-or-v1-..."/>
                                    </div>
                                    <div class="text-muted">
                                        Get your API key from <a href="https://openrouter.ai/keys" target="_blank">OpenRouter</a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- AI Model Configuration -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="openrouter_model" string="AI Model" class="col-3 col-lg-3 o_light_label"/>
                                        <field name="openrouter_model"/>
                                    </div>
                                    <div class="row mt8">
                                        <div class="col-3 col-lg-3"></div>
                                        <div class="col-9 col-lg-9">
                                            <button name="action_refresh_models"
                                                    type="object"
                                                    string="🔄 Refresh Models"
                                                    class="btn btn-sm btn-secondary"
                                                    attrs="{'invisible': [('openrouter_api_key', '=', False)]}"/>
                                            <field name="openrouter_models_last_update"
                                                   readonly="1"
                                                   class="ms-2"
                                                   attrs="{'invisible': [('openrouter_models_last_update', '=', False)]}"/>
                                        </div>
                                    </div>
                                    <div class="text-muted">
                                        Select from available OpenRouter models. Click "Refresh Models" to fetch the latest list.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Temperature -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="openrouter_temperature" string="Temperature" class="col-3 col-lg-3 o_light_label"/>
                                        <field name="openrouter_temperature"/>
                                    </div>
                                    <div class="text-muted">
                                        Controls randomness (0-2): Lower values are more focused, higher values are more creative
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Max Tokens -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="openrouter_max_tokens" string="Max Tokens" class="col-3 col-lg-3 o_light_label"/>
                                        <field name="openrouter_max_tokens"/>
                                    </div>
                                    <div class="text-muted">
                                        Maximum tokens to generate in responses
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- MCP Tools -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="mcp_tools_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="mcp_tools_enabled"/>
                                <div class="text-muted">
                                    Allow AI to use MCP tools to search, read, and interact with Odoo data
                                </div>
                            </div>
                        </div>

                        <!-- System Prompt -->
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="ai_system_prompt" string="System Prompt" class="col-3 col-lg-3 o_light_label"/>
                                        <field name="ai_system_prompt" widget="text"/>
                                    </div>
                                    <div class="text-muted">
                                        System prompt that defines the AI assistant's behavior and personality
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Site Info -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="site_url" string="Site URL" class="col-3 col-lg-3 o_light_label"/>
                                        <field name="site_url" placeholder="https://yourcompany.com"/>
                                    </div>
                                    <div class="text-muted">
                                        Your site URL for OpenRouter attribution (optional)
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="site_name" string="Site Name" class="col-3 col-lg-3 o_light_label"/>
                                        <field name="site_name" placeholder="My Company"/>
                                    </div>
                                    <div class="text-muted">
                                        Your site name for OpenRouter attribution (optional)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
